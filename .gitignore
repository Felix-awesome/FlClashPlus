# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
# iOS project files are generated by `flutter create` on the CI runner, not
# tracked in git (only the hand-written FlClashService/Runner sources are).
/ios/Flutter/
/ios/Runner.xcodeproj/
/ios/Runner.xcworkspace/
/ios/Runner/GeneratedPluginRegistrant.h
/ios/Runner/GeneratedPluginRegistrant.m
/ios/Podfile
/ios/Podfile.lock
/ios/Pods/
/ios/.symlinks/
/ios/FlClashCore.xcframework/
.dart_tool/
/.widget_preview/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Claude Code - ignore user-specific settings only
.claude/settings.local.json
.claude/worktrees/

# Documentation (generated/planning artifacts)
docs/


# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/**/.cxx
/android/**/build
/android/common/**/.**/
/android/common/local.*
# Left in place by builds from before the gomobile Core.
/android/core/**/includes/
/android/core/**/cmake-build-*/
/android/core/**/jniLibs/

